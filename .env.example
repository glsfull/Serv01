SERV01_ENVIRONMENT=development
SERV01_DATABASE_URL=sqlite+pysqlite:///./serv01.db
SERV01_JWT_SECRET=replace-with-a-long-random-secret
SERV01_ACCESS_TOKEN_MINUTES=60
SERV01_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SERV01_REDIS_URL=redis://localhost:6379/0
SERV01_QUEUE_NAME=default
SERV01_ALLOWED_HOSTS=example.com,www.iana.org,httpbin.org
SERV01_SCREENSHOT_DIR=./data/screenshots
SERV01_BOT_USER_AGENT=Serv01Bot/0.1 (+contact@example.com)
SERV01_PAGE_TIMEOUT_SECONDS=30
